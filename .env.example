DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Use a public HTTPS tunnel URL for local webhook testing.
APP_BASE_URL="https://your-public-host.example"
NEXT_PUBLIC_APP_BASE_URL="https://your-public-host.example"

# Enable repository chat and indexing. Set to 0 for diff-only PR reviews.
REPOSITORY_INDEXING_ENABLED="1"
# Required only when repository indexing is enabled.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Groq repository chat and pull-request reviews.
GROQ_API_KEY=""

# Must match the PostgreSQL vector column.
EMBEDDING_DIMENSIONS="768"

# Use 1 with the local Inngest dev server; use 0 in production.
INNGEST_DEV="1"

# Required in production. Obtain both from your Inngest environment.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
