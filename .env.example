DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Use a public HTTPS tunnel URL for local webhook testing.
APP_BASE_URL="https://your-public-host.example"
NEXT_PUBLIC_APP_BASE_URL="https://your-public-host.example"

# Gemini embeddings for repository indexing and retrieval.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Groq repository chat and pull-request reviews.
GROQ_API_KEY=""

# Optional. PostgreSQL is the durable vector store; Pinecone accelerates retrieval when configured.
PINECONE_DB_API_KEY=""
PINECONE_INDEX="codesentinal-vector-embeddings"
EMBEDDING_DIMENSIONS="768"

# Use 1 with the local Inngest dev server; use 0 in production.
INNGEST_DEV="1"
